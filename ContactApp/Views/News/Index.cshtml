@model IReadOnlyList<ContactApp.Contracts.DTOs.NewsArticleDto>
<h1 class="mb-4">Haberler</h1>

@if (Model is null || Model.Count==0)
{
	<div class="alert alert-info">
		Herhangi bir haber bulunamadı!
	</div>
}
else // kullanıcıya gösterilecek haber varsa şu şekilde göster
{
	<div  class="table-responsive">
		<table class="table table-striped align-middle">
			<thead>
				<tr>
					<th>Title</th>
					<th>Author</th>
					<th>Status</th>
					<th>Published</th>
					<th>Summary</th>
				</tr>
			</thead>
			<tbody>
				@foreach (var item in Model)
				{
					<tr>
						<td>
							<a asp-controller="News" asp-action="Details" asp-route-id="@item.Id">
								@*asp-action hangi metodun çalışacağını, asp-route-id ise o metoda verilecek parametreyi temsil eder*@
								@item.Title
							</a>
						</td>
						<td>@item.Authorname</td>
						<td>@item.Status</td>
						<td>(@item.PublishedAt?.ToString("yyyy-MM-dd HH:mm") ?? "-")</td>
						<td>@item.Summary</td>
					</tr>
				}
			</tbody>
		</table>
	</div>
}